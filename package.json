{
  "name": "@luminarylane/fathom-mcp-server",
  "version": "1.0.0",
  "description": "Standalone Fathom MCP Server — meeting intelligence SENSE tools",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bin": {
    "luminarylane-fathom-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luminarylane/fathom-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/luminarylane/fathom-mcp-server/issues"
  },
  "homepage": "https://github.com/luminarylane/fathom-mcp-server#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "langfuse": "^3.38.20",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.19.0",
    "prettier": "^3.8.2",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "fast-uri": "^3.1.4"
  }
}
